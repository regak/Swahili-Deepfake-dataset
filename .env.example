# Copy this file to .env in the repo root and fill in your real key:
#   cp .env.example .env
#
# .env is git-ignored -- never commit your real API key.
#
# Used by the `datacollective` SDK (see notebooks/download_mdc_common_voice_sw.ipynb)
# to authenticate with the Mozilla Data Collective API when downloading the
# Common Voice Swahili corpus. Generate a key at https://mozilladatacollective.com
# after creating an account and agreeing to the dataset's Terms & Conditions.
MDC_API_KEY=your-mdc-api-key-here
