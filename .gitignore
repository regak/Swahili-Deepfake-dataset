__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/
venv/

# Never commit real secrets; .env.example documents the expected keys.
.env

# Dataset artifacts are large and reproducible from the pipeline; they are
# not committed to git. Publish releases via a dataset host (e.g. Zenodo,
# Hugging Face Datasets) instead. See docs/METHODOLOGY.md.
data/raw/*
data/processed/*
data/generated/*
data/manifests/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/generated/.gitkeep
!data/manifests/.gitkeep
